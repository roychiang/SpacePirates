{$SPACEPIRATES_DOMAIN} {
    root * /srv/spacepirates
    file_server

    # Bot detection: serve static landing page to crawlers and AI bots
    @bot {
        not path /assets/* /robots.txt /sitemap.xml /llms.txt /openapi.yaml /static-landing.html /.well-known/*
        header_regexp User-Agent (?i)(googlebot|bingbot|slurp|duckduckbot|yandexbot|baiduspider|GPTBot|ChatGPT-User|ClaudeBot|anthropic-ai|PerplexityBot|Google-Extended|GoogleOther|cohere-ai|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Discordbot|TelegramBot)
    }
    rewrite @bot /static-landing.html

    @ws {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @ws server:2567
    reverse_proxy /colyseus server:2567
    reverse_proxy /api/* server:2567
    reverse_proxy /.well-known/* server:2567
    reverse_proxy /openapi.yaml server:2567
}

